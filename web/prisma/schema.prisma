generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                   String          @id @default(cuid())
  name                 String?
  email                String          @unique
  password             String
  role                 String          @default("STUDENT")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  studentFamilyMembers FamilyMember[]  @relation("StudentFamily")
  familyMembers        FamilyMember[]
  parentProfile        ParentProfile?
  studentProfile       StudentProfile?
}

model StudentProfile {
  id                String                    @id @default(cuid())
  userId            String                    @unique
  age               Int?
  education         String?
  stream            String?
  marks             Float?
  location          String?
  interests         String
  skills            String
  budget            String?
  preferredLoc      String?
  careerGoal        String?
  coursePrefs       String
  assessments       Assessment[]
  decisionRooms     FamilyDecisionRoom[]
  recommendations   Recommendation[]
  savedOptions      SavedOption[]
  skillGaps         SkillGap[]
  careerPreferences StudentCareerPreference[]
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assessment {
  id               String         @id @default(cuid())
  studentProfileId String
  logical          Int            @default(0)
  numerical        Int            @default(0)
  technical        Int            @default(0)
  creativity       Int            @default(0)
  communication    Int            @default(0)
  practical        Int            @default(0)
  problemSolving   Int            @default(0)
  createdAt        DateTime       @default(now())
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model Career {
  id                String           @id @default(cuid())
  title             String
  description       String
  reqEducation      String
  reqSkills         String
  careerProgression String?
  courses           Course[]
  recommendations   Recommendation[]
}

model Course {
  id          String     @id @default(cuid())
  name        String
  duration    String
  fees        Float
  eligibility String
  careerId    String?
  instituteId String?
  institute   Institute? @relation(fields: [instituteId], references: [id])
  career      Career?    @relation(fields: [careerId], references: [id])
}

model Institute {
  id           String   @id @default(cuid())
  name         String
  location     String
  feesAvg      Float?
  officialInfo String?
  courses      Course[]
}

model Scholarship {
  id             String   @id @default(cuid())
  title          String
  eligibility    String
  amount         Float
  deadline       DateTime
  officialSource String?
}

model Recommendation {
  id               String         @id @default(cuid())
  studentProfileId String
  careerId         String
  matchScore       Float
  explanation      String?
  createdAt        DateTime       @default(now())
  career           Career         @relation(fields: [careerId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model SkillGap {
  id               String         @id @default(cuid())
  studentProfileId String
  missingSkills    String
  learningPlan     String?
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id         String  @id @default(cuid())
  userId     String
  studentId  String
  relation   String
  authorized Boolean @default(false)
  student    User    @relation("StudentFamily", fields: [studentId], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedOption {
  id               String         @id @default(cuid())
  studentProfileId String
  itemType         String
  itemId           String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model ParentProfile {
  id                    String                   @id @default(cuid())
  userId                String                   @unique
  education             String?
  occupation            String?
  preferredSectors      String?
  preferredEduLevel     String?
  preferredLocation     String?
  budget                String?
  employmentVsHigherEdu String?
  vocationalWillingness Boolean?
  decisionRooms         FamilyDecisionRoom[]
  preferences           ParentCareerPreference[]
  concerns              ParentConcern[]
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ParentConcern {
  id              String        @id @default(cuid())
  parentProfileId String
  concern         String
  importance      String
  isCustom        Boolean       @default(false)
  parentProfile   ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
}

model ParentCareerPreference {
  id              String        @id @default(cuid())
  parentProfileId String
  careerId        String?
  careerName      String
  sector          String?
  parentProfile   ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
}

model StudentCareerPreference {
  id               String         @id @default(cuid())
  studentProfileId String
  careerId         String?
  careerName       String
  sector           String?
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model FamilyDecisionRoom {
  id               String             @id @default(cuid())
  studentProfileId String
  parentProfileId  String
  status           String             @default("NEEDS_DISCUSSION")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  comparisons      CareerComparison[]
  conflicts        CareerConflict[]
  actionPlans      FamilyActionPlan[]
  parentProfile    ParentProfile      @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model CareerConflict {
  id                   String             @id @default(cuid())
  familyDecisionRoomId String
  conflictType         String
  studentPref          String
  parentPref           String
  severity             String
  reason               String
  familyDecisionRoom   FamilyDecisionRoom @relation(fields: [familyDecisionRoomId], references: [id], onDelete: Cascade)
}

model CareerComparison {
  id                   String             @id @default(cuid())
  familyDecisionRoomId String
  studentCareerId      String?
  parentCareerId       String?
  comparisonData       String
  familyDecisionRoom   FamilyDecisionRoom @relation(fields: [familyDecisionRoomId], references: [id], onDelete: Cascade)
}

model FamilyActionPlan {
  id                   String             @id @default(cuid())
  familyDecisionRoomId String
  chosenCareer         String
  reasoning            String
  requiredSkills       String
  recommendedEdu       String
  approxCost           String
  careerPathway        String
  nextAction           String
  longTermAction       String
  discussionPoints     String
  status               String             @default("SHORTLISTED")
  familyDecisionRoom   FamilyDecisionRoom @relation(fields: [familyDecisionRoomId], references: [id], onDelete: Cascade)
}

model Sector {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  trades      Trade[]
}

model Trade {
  id               String               @id @default(cuid())
  name             String
  sectorId         String
  ncoCode          String?
  nsqfLevel        Int?
  forecasts        Forecast[]
  gapAnalyses      GapAnalysis[]
  demandSignals    LabourDemandSignal[]
  sector           Sector               @relation(fields: [sectorId], references: [id])
  trainingCapacity TrainingCapacity[]
}

model Location {
  id               String               @id @default(cuid())
  state            String
  district         String
  forecasts        Forecast[]
  gapAnalyses      GapAnalysis[]
  demandSignals    LabourDemandSignal[]
  trainingCapacity TrainingCapacity[]

  @@unique([state, district])
}

model LabourDemandSignal {
  id         String   @id @default(cuid())
  tradeId    String
  locationId String
  value      Int
  source     String
  period     String
  createdAt  DateTime @default(now())
  location   Location @relation(fields: [locationId], references: [id])
  trade      Trade    @relation(fields: [tradeId], references: [id])
}

model TrainingCapacity {
  id             String   @id @default(cuid())
  tradeId        String
  locationId     String
  capacity       Int
  instituteCount Int?
  period         String
  createdAt      DateTime @default(now())
  location       Location @relation(fields: [locationId], references: [id])
  trade          Trade    @relation(fields: [tradeId], references: [id])
}

model Forecast {
  id                 String   @id @default(cuid())
  tradeId            String
  locationId         String
  horizonMonths      Int
  forecastedDemand   Int
  forecastedCapacity Int
  trend              String
  createdAt          DateTime @default(now())
  location           Location @relation(fields: [locationId], references: [id])
  trade              Trade    @relation(fields: [tradeId], references: [id])
}

model GapAnalysis {
  id              String   @id @default(cuid())
  tradeId         String
  locationId      String
  currentDemand   Int
  currentCapacity Int
  gap             Int
  status          String
  severity        String
  period          String
  createdAt       DateTime @default(now())
  alerts          Alert[]
  location        Location @relation(fields: [locationId], references: [id])
  trade           Trade    @relation(fields: [tradeId], references: [id])
}

model Alert {
  id            String      @id @default(cuid())
  gapAnalysisId String
  message       String
  priority      String
  createdAt     DateTime    @default(now())
  gapAnalysis   GapAnalysis @relation(fields: [gapAnalysisId], references: [id])
}
